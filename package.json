{
  "name": "review-pilot",
  "displayName": "Review Pilot",
  "description": "AI-assisted code review in Visual Studio Code.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "reviewPilot.reviewSelectedCode", "title": "Review Pilot: Review Selected Code" },
      { "command": "reviewPilot.reviewCurrentFile", "title": "Review Pilot: Review Current File" },
      { "command": "reviewPilot.reviewGitDiff", "title": "Review Pilot: Review Git Diff" },
      { "command": "reviewPilot.refreshResults", "title": "Review Pilot: Refresh Results", "icon": "$(refresh)" },
      { "command": "reviewPilot.openIssue", "title": "Review Pilot: Open Issue" },
      { "command": "reviewPilot.copySuggestion", "title": "Review Pilot: Copy Suggestion" },
      { "command": "reviewPilot.openSettings", "title": "Review Pilot: Open Settings", "icon": "$(gear)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "reviewPilot", "title": "Review Pilot", "icon": "media/review-pilot.svg" }
      ]
    },
    "views": {
      "reviewPilot": [
        { "id": "reviewPilot.results", "name": "Review Results" }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "reviewPilot.reviewSelectedCode",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "reviewPilot.refreshResults",
          "when": "view == reviewPilot.results",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Review Pilot",
      "properties": {
        "reviewPilot.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key used to authenticate review requests.",
          "scope": "window"
        },
        "reviewPilot.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "pattern": "^https?://.+",
          "description": "Base URL for the OpenAI-compatible API.",
          "scope": "window"
        },
        "reviewPilot.model": {
          "type": "string",
          "default": "gpt-4.1-mini",
          "minLength": 1,
          "description": "Model used for code review.",
          "scope": "window"
        },
        "reviewPilot.language": {
          "type": "string",
          "default": "auto",
          "minLength": 1,
          "description": "Review language, or auto to match the code context.",
          "scope": "window"
        },
        "reviewPilot.defaultMode": {
          "type": "string",
          "enum": ["selection", "file", "diff"],
          "default": "selection",
          "description": "Default scope for a review.",
          "scope": "window"
        },
        "reviewPilot.maxIssues": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of issues returned by a review.",
          "scope": "window"
        },
        "reviewPilot.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 120000,
          "description": "Maximum request duration in milliseconds.",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
